generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  DEALER
  ADMIN
}

enum ListingStatus {
  DRAFT
  PENDING
  PUBLISHED
  RESERVED
  SOLD
  REJECTED
}

enum VehicleCondition {
  NEW
  FOREIGN_USED
  NIGERIAN_USED
  CERTIFIED_PRE_OWNED
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum TransmissionType {
  AUTOMATIC
  MANUAL
}

enum BodyType {
  SEDAN
  SUV
  COUPE
  HATCHBACK
  TRUCK
  VAN
  CONVERTIBLE
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

model User {
  id             String           @id @default(cuid())
  name           String?
  email          String           @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  role           UserRole         @default(USER)
  phone          String?
  location       String?
  favorites      Favorite[]
  inquiries      Inquiry[]        @relation("InquiryCustomer")
  reviews        Review[]
  listings       CarListing[]     @relation("ListingSeller")
  dealerProfile  DealerProfile?
  savedSearches  SavedSearch[]
  accounts       Account[]
  sessions       Session[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([role])
  @@index([createdAt])
}

model DealerProfile {
  id               String       @id @default(cuid())
  userId           String       @unique
  businessName     String
  slug             String       @unique
  description      String?
  phone            String?
  website          String?
  address          String?
  city             String?
  state            String?
  logoUrl          String?
  coverImageUrl    String?
  verified         Boolean      @default(false)
  responseRate     Int          @default(0)
  responseTimeMins Int          @default(60)
  ratingAverage    Float        @default(0)
  totalReviews     Int          @default(0)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings         CarListing[]
  inquiries        Inquiry[]    @relation("InquiryDealer")
  reviews          Review[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([verified])
  @@index([businessName])
}

model CarListing {
  id                String             @id @default(cuid())
  slug              String             @unique
  title             String
  make              String
  model             String
  trim              String?
  year              Int
  price             Int
  mileage           Int
  engine            String?
  fuelType          FuelType
  transmission      TransmissionType
  bodyType          BodyType
  color             String
  condition         VehicleCondition
  description       String             @db.Text
  location          String
  city              String?
  state             String?
  featured          Boolean            @default(false)
  status            ListingStatus      @default(DRAFT)
  vin               String?            @unique
  seats             Int?
  drivetrain        String?
  doors             Int?
  sellerId          String
  dealerId          String?
  publishedAt       DateTime?
  images            CarImage[]
  inquiries         Inquiry[]
  favorites         Favorite[]
  seller            User               @relation("ListingSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  dealer            DealerProfile?     @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, featured, createdAt])
  @@index([make, model])
  @@index([price])
  @@index([year])
  @@index([mileage])
  @@index([fuelType, transmission, bodyType])
  @@index([location])
  @@index([sellerId])
  @@index([dealerId])
}

model CarImage {
  id           String      @id @default(cuid())
  listingId    String
  url          String
  publicId     String?
  altText      String?
  width        Int?
  height       Int?
  position     Int         @default(0)
  isPrimary    Boolean     @default(false)
  listing      CarListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@index([listingId, position])
}

model Inquiry {
  id            String         @id @default(cuid())
  listingId     String?
  customerId    String?
  dealerId      String?
  name          String
  email         String
  phone         String?
  message       String         @db.Text
  status        InquiryStatus  @default(NEW)
  listing       CarListing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)
  customer      User?          @relation("InquiryCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  dealer        DealerProfile? @relation("InquiryDealer", fields: [dealerId], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([listingId, createdAt])
  @@index([customerId])
  @@index([dealerId])
  @@index([status])
}

model Favorite {
  id         String      @id @default(cuid())
  userId     String
  listingId  String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing    CarListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@unique([userId, listingId])
  @@index([listingId])
}

model ContactMessage {
  id          String      @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String?
  message     String      @db.Text
  resolved    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([createdAt])
  @@index([resolved])
}

model Review {
  id          String          @id @default(cuid())
  userId      String?
  dealerId    String?
  name        String
  roleLabel   String?
  rating      Int
  quote       String          @db.Text
  featured    Boolean         @default(false)
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  dealer      DealerProfile?  @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([featured])
}

model SavedSearch {
  id          String      @id @default(cuid())
  userId      String
  label       String
  query       String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
}

model SiteSetting {
  id          String      @id @default(cuid())
  key         String      @unique
  value       Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id            String   @id @default(cuid())
  sessionToken  String   @unique
  userId        String
  expires       DateTime
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier  String
  token       String   @unique
  expires     DateTime

  @@unique([identifier, token])
}
